# Application
APP_NAME=MyLofi
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mylofi
DATABASE_ECHO=false

# Redis (for background tasks, caching, WebSocket scaling)
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]

# Vision API (for food recognition)
VISION_API_URL=http://localhost:8001/analyze
VISION_API_KEY=your-vision-api-key

# Web Push (VAPID keys for push notifications)
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_CLAIMS_SUB=mailto:admin@mylofi.app

# File upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads